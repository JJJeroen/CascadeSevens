{
  // Serves the committed docs/ build as a static site on Cloudflare.
  // Non-main branches get a preview URL (Workers Builds "preview command").
  // "name" must match the Worker/project name in the Cloudflare dashboard.
  "name": "cascadesevens",
  "compatibility_date": "2026-10-12",
  "assets": {
    "directory": "./docs"
  }
}
